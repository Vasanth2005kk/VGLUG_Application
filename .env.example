# Docker Compose configuration. Copy to `.env` (same folder as docker-compose.yml) and edit.
# Never commit the real .env.

# ---- Required secrets -------------------------------------------------------
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
# Use letters, digits, '-' and '_' only (it is embedded in a database URL).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=replace-with-a-strong-password

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=vglug
POSTGRES_DB=vglug
# Host port for local tools (psql, `uv run app.py`). Bound to 127.0.0.1 only.
DB_HOST_PORT=5433

# ---- Web ---------------------------------------------------------------------
# The site is served at http://localhost:${APP_PORT}
APP_PORT=8080
APP_ENV=production
# Public origin, used for links inside emails
PUBLIC_BASE_URL=http://localhost:8080
# Set to true when the site is served over HTTPS
SESSION_COOKIE_SECURE=false
ADMIN_SESSION_HOURS=8
# nginx in the frontend container counts as 1. Use 2 if another reverse proxy (HTTPS) sits in front.
TRUST_PROXY_COUNT=1
# Keep 1 worker unless RATELIMIT_STORAGE_URI points to a shared store (e.g. Redis);
# with memory:// each worker keeps its own rate-limit counters.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# ---- Initial administrator (only used when no admin exists) ----------------
INITIAL_ADMIN_USERNAME=vglug
INITIAL_ADMIN_PASSWORD=vglug@123

# ---- Media -------------------------------------------------------------------
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200

# ---- Rate limiting -------------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://

# ---- Comments ----------------------------------------------------------------
COMMENTS_REQUIRE_APPROVAL=true
COMMENT_MAX_LENGTH=2000
COMMENT_MAX_LINKS=2

# ---- Email: EMAIL_BACKEND = console (logs only) | smtp | disabled ---------------
SUBSCRIPTIONS_ENABLED=true
EMAIL_BACKEND=console
EMAIL_FROM="VGLUG <updates@example.org>"
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
# starttls | ssl | none
SMTP_SECURITY=starttls
EMAIL_MAX_ATTEMPTS=5
SUBSCRIPTION_TOKEN_HOURS=48

LOG_LEVEL=INFO
